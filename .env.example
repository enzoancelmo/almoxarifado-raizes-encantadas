# Banco PostgreSQL (não versionar o arquivo .env real)
POSTGRES_DB=almoxarifado_raizes
POSTGRES_USER=raizes_user
POSTGRES_PASSWORD=estoque_pass

# Segurança
JWT_SECRET=troque-esta-chave-por-outra-com-pelo-menos-32-caracteres
JWT_EXPIRATION=86400000
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=http://localhost

# Administrador criado no primeiro startup
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@raizesencantadas.com
ADMIN_PASSWORD=admin123

# Frontend em nuvem (Vercel/Render Static Site)
# Exemplo: https://almoxarifado-backend.onrender.com
FRONTEND_API_URL=/api
