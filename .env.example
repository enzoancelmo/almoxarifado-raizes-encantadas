# Banco PostgreSQL (não versionar o arquivo .env real)
POSTGRES_DB=estoque_inteligente
POSTGRES_USER=estoque_user
POSTGRES_PASSWORD=estoque_pass

# Segurança
JWT_SECRET=troque-esta-chave-por-outra-com-pelo-menos-32-caracteres
JWT_EXPIRATION=86400000
SPRING_PROFILES_ACTIVE=prod

# Administrador criado no primeiro startup
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@estoque.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
